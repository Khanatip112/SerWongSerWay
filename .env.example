# ==============================================================================
# PastelPulse Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
TZ=Asia/Bangkok
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pastelpulse?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pastelpulse_test?schema=public
SESSION_SECRET=change_me_to_a_secure_random_secret_in_production
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# PostgreSQL (Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pastelpulse
POSTGRES_PORT=5432

# Client Runtime
CLIENT_PORT=5173
VITE_API_URL=http://localhost:4000

# Seed Accounts (Local Development Placeholders)
SEED_DEFAULT_PASSWORD=ChangeMeLocalDev123!
CREATOR1_PASSWORD=example-password-1
CREATOR2_PASSWORD=example-password-2
RESPONDENT1_PASSWORD=example-password-3
RESPONDENT2_PASSWORD=example-password-4