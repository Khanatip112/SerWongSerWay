datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CREATOR
  RESPONDENT
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  RATING_5
  TEXT
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         UserRole
  createdAt    DateTime      @default(now())
  campaigns    Campaign[]
  submissions  Submission[]

  @@map("users")
}

model Campaign {
  id          String         @id @default(uuid())
  creatorId   String
  title       String
  description String
  status      CampaignStatus @default(PUBLISHED)
  closesAt    DateTime?
  createdAt   DateTime       @default(now())

  creator     User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  questions   Question[]
  submissions Submission[]

  @@map("campaigns")
}

model Question {
  id          String       @id @default(uuid())
  campaignId  String
  prompt      String
  type        QuestionType
  required    Boolean      @default(true)
  orderIndex  Int

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@map("questions")
}

model Submission {
  id           String    @id @default(uuid())
  campaignId   String
  respondentId String
  submittedAt  DateTime  @default(now())

  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  respondent   User      @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@unique([campaignId, respondentId])
  @@map("submissions")
}

model Answer {
  id           String     @id @default(uuid())
  submissionId String
  questionId   String
  ratingValue  Int?
  textValue    String?

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}
