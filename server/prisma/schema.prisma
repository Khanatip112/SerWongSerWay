datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CREATOR
  RESPONDENT
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  RATING_5
  TEXT
  SHORT_ANSWER
  PARAGRAPH
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  FILE_UPLOAD
  LINEAR_SCALE
  RATING
  MULTIPLE_CHOICE_GRID
  CHECKBOX_GRID
  DATE
  TIME
}

enum SectionNextAction {
  NEXT_SECTION
  GO_TO_SECTION
  SUBMIT_FORM
}

enum ContentBlockType {
  TEXT_BLOCK
  IMAGE_BLOCK
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         UserRole
  createdAt    DateTime      @default(now())
  campaigns    Campaign[]
  submissions  Submission[]

  @@map("users")
}

model Campaign {
  id          String         @id @default(uuid())
  creatorId   String
  title       String
  description String
  status      CampaignStatus @default(PUBLISHED)
  closesAt    DateTime?
  createdAt   DateTime       @default(now())

  creator       User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  sections      Section[]
  questions     Question[]
  contentBlocks ContentBlock[]
  submissions   Submission[]

  @@map("campaigns")
}

model Section {
  id              String            @id @default(uuid())
  campaignId      String
  title           String
  description     String?
  orderIndex      Int
  nextAction      SectionNextAction @default(NEXT_SECTION)
  targetSectionId String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("sections")
}

model Question {
  id          String       @id @default(uuid())
  campaignId  String
  sectionId   String?
  prompt      String
  description String?
  type        QuestionType
  required    Boolean      @default(true)
  orderIndex  Int
  config      Json         @default("{}")
  image       Json?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers     Answer[]

  @@map("questions")
}

model ContentBlock {
  id          String           @id @default(uuid())
  campaignId  String
  sectionId   String?
  type        ContentBlockType
  title       String?
  description String?
  config      Json             @default("{}")
  orderIndex  Int

  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("content_blocks")
}

model Submission {
  id           String    @id @default(uuid())
  campaignId   String
  respondentId String
  submittedAt  DateTime  @default(now())

  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  respondent   User      @relation(fields: [respondentId], references: [id], onDelete: Cascade)
  answers      Answer[]

  @@unique([campaignId, respondentId])
  @@map("submissions")
}

model Answer {
  id           String     @id @default(uuid())
  submissionId String
  questionId   String
  ratingValue  Int?
  textValue    String?
  jsonValue    Json?

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}
